# Copy this file to .env and fill in local development credentials.
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/fitmind
GOOGLE_API_KEY=your-google-ai-studio-key
APP_ENV=development
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set a long random value for production deployments.
# Local development falls back to a key derived from DATABASE_URL.
# AUTH_SECRET_KEY=replace-with-a-long-random-secret
